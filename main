#!/usr/bin/env bash
set -euo pipefail
# Set this to the published, versioned image in each generated app repository.
image="${CONTACTOME_IMAGE:-docker://ghcr.io/jhuapl-boss/bossdb-brainlife-apps:sha-$(git rev-parse HEAD)}"
if command -v apptainer >/dev/null 2>&1; then
    runtime=apptainer
else
    runtime=singularity
fi
# Preserve the resource credential chain; never serialize credentials into config.json.
exec "$runtime" exec --bind "$PWD:/work" --pwd /work "$image" \
    ./run_local_contactome.sh
