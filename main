#!/usr/bin/env bash
set -euo pipefail

image="${BOSSDB_NUCLEI_IMAGE:-docker://ghcr.io/jhuapl-boss/bossdb-brainlife-apps:sha-$(git rev-parse HEAD)}"

if command -v apptainer >/dev/null 2>&1; then
    runtime=apptainer
else
    runtime=singularity
fi

exec "$runtime" exec --nv --bind "$PWD:/work" --pwd /work "$image" \
    python /opt/bossdb-nuclei/nuclei_inference.py
